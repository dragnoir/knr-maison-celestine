{% comment %}
  KNR FAQ. Editable content is supplied through section settings or Shopify resources.
{% endcomment %}
<div id='knr-faq'>
  <h2>{{ section.settings.heading | escape }}</h2>
  <knr-accordions class='knr-faq__list'>
    {% for block in section.blocks %}
      <details
        {% if forloop.first %}
          open
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <summary>
          {{ block.settings.question | escape -}}
          {%- render 'knr-icon', name: 'knr-desktop-icon1', width: 6.41421, height: 10.8284 %}
        </summary>
        <div class='knr-accordion__content' data-knr-accordion-content>
          <div class='knr-faq__answer'>{{ block.settings.answer }}</div>
        </div>
      </details>
    {% endfor %}
  </knr-accordions>
</div>
{% render 'knr-accordion-styles' %}
{% stylesheet %}
  .knr-faq {
    padding: 120px 40px;
  }
  .knr-faq h2 {
    text-align: center;
    font-size: 40px;
    line-height: 48px;
    letter-spacing: -0.04em;
    margin-bottom: 80px;
  }
  .knr-faq__list {
    max-width: 720px;
    margin: auto;
  }
  .knr-faq details {
    box-shadow: inset 0 1px #0000003d;
    padding-block: 20px;
  }
  .knr-faq summary {
    padding: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    cursor: pointer;
    list-style: none;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.04em;
  }
  .knr-faq summary::-webkit-details-marker {
    display: none;
  }
  .knr-faq summary img {
    transform: rotate(90deg);
  }
  .knr-faq details[open] summary img {
    transform: rotate(-90deg);
  }
  .knr-faq__answer {
    font-size: 14px;
    line-height: 22px;
    letter-spacing: -0.02em;
    padding-block-start: 16px;
  }
  .knr-faq__answer p + p {
    margin-block-start: 12px;
  }
  @media (max-width: 749px) {
    .knr-faq {
      padding: 40px 24px;
    }
    .knr-faq h2 {
      font-size: 32px;
      line-height: 40px;
      margin-bottom: 40px;
    }
    .knr-faq summary {
      font-size: 24px;
      line-height: 32px;
      letter-spacing: -0.02em;
    }
    .knr-faq details {
      box-shadow: inset 0 1px #0035923d;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:knr.knr_faq",
  "tag": "section",
  "class": "knr-section knr-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:knr.heading"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:knr.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:knr.question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:knr.answer"
        }
      ]
    }
  ]
}
{% endschema %}
