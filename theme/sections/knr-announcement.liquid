{% comment %}
  KNR announcement. Editable content is supplied through section settings or Shopify resources.
{% endcomment %}
<div class='knr-announcement__inner' role='region' aria-label='{{ 'knr.announcement' | t }}'>
  <span>{{ section.settings.text | escape }}</span>
  {% if section.settings.link != blank -%}
    <a class='knr-link' href='{{ section.settings.link }}'>
      {{- section.settings.link_text | escape -}}
    </a>
  {%- endif %}
</div>
{% stylesheet %}
  .knr-announcement__inner {
    min-height: 32px;
    background: var(--knr-ink);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    padding: 9px 16px;
    font-size: 12px;
    line-height: 12px;
    text-align: center;
    letter-spacing: 0;
  }
  .knr-announcement__inner > * {
    padding-bottom: 2px;
  }
  .knr-announcement__inner a {
    box-shadow: inset 0 -1px currentColor;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:knr.knr_announcement",
  "tag": "section",
  "class": "knr-section knr-announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:knr.announcement"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "t:knr.link_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:knr.link"
    }
  ]
}
{% endschema %}
