{% comment %}
  KNR usage. Editable content is supplied through section settings or Shopify resources.
{% endcomment %}
<h2 class='knr-heading'>{{ section.settings.heading | escape }}</h2>
<knr-scroller>
  <div
    class='knr-usage__list'
    data-knr-scroll
    tabindex='0'
    role='region'
    aria-label='{{ section.settings.heading | escape }}'
  >
    {% for block in section.blocks %}
      <article class='knr-usage__card' {{ block.shopify_attributes }}>
        <div class='knr-usage__image'>
          {% render 'knr-image',
            image: block.settings.image,
            sizes: '(min-width: 750px) 32vw, 255px',
            alt: block.settings.image.alt
          %}
        </div>
        <div class='knr-usage__body'>
          <span class='knr-usage__number'>{{ forloop.index | prepend: '0' }}</span>
          <h3>{{ block.settings.heading | escape }}</h3>
          <div class='knr-usage__text'>{{ block.settings.body }}</div>
          {% if block.settings.link != blank -%}
            <a class='knr-link' href='{{ block.settings.link }}'>{{ 'knr.read_more' | t }}</a>
          {%- endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  {% render 'knr-scroll-progress' %}
</knr-scroller>
{% stylesheet %}
  .knr-usage {
    padding: 40px 0 120px;
  }
  .knr-usage > .knr-heading {
    padding-inline: 40px;
    margin-block-end: 40px;
  }
  .knr-usage__list {
    display: flex;
    gap: 8px;
    padding-inline: 40px;
    overflow: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .knr-usage__card {
    flex: 1;
    min-width: 0;
    scroll-snap-align: start;
  }
  .knr-usage__image {
    aspect-ratio: 1;
    overflow: hidden;
  }
  .knr-usage__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .knr-usage__body {
    display: grid;
    gap: 16px;
    padding: 24px 24px 0;
  }
  .knr-usage__number {
    font-size: 14px;
    line-height: 14px;
    letter-spacing: -0.04em;
  }
  .knr-usage__body h3 {
    font-size: 24px;
    line-height: 32px;
    letter-spacing: -0.02em;
  }
  .knr-usage__text {
    font-size: 14px;
    line-height: 22px;
    letter-spacing: -0.02em;
  }
  .knr-usage__body .knr-link {
    justify-self: start;
    display: none;
  }
  @media (max-width: 749px) {
    .knr-usage {
      padding: 40px 0 64px;
    }
    .knr-usage > .knr-heading {
      padding-inline: 24px;
    }
    .knr-usage__list {
      padding-inline: 24px;
      scroll-padding-inline: 24px;
    }
    .knr-usage__card {
      flex: 0 0 255px;
    }
    .knr-usage__body {
      display: flex;
      flex-direction: column;
      padding-inline: 16px 18px;
    }
    .knr-usage__body .knr-link {
      display: inline-block;
      padding-bottom: 0;
      align-self: flex-start;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:knr.knr_usage",
  "tag": "section",
  "class": "knr-section knr-usage",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:knr.heading"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:knr.usage_step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:knr.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:knr.heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "t:knr.description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:knr.read_more_link"
        }
      ]
    }
  ]
}
{% endschema %}
