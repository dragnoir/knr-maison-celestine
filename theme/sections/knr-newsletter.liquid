{% comment %}
  KNR newsletter. Editable content is supplied through section settings or Shopify resources.
{% endcomment %}
<div class='knr-newsletter__image'>
  {% render 'knr-image',
    image: section.settings.image,
    sizes: '(min-width: 750px) 50vw, 100vw',
    alt: section.settings.image.alt
  %}
</div>
<div class='knr-newsletter__content'>
  <h2>{{ section.settings.heading | escape }}</h2>
  {% assign form_id = 'KnrNewsletter-' | append: section.id -%}
  {%- assign return_url = request.path
    | append: '?view=knr-serum&customer_posted=true#'
    | append: form_id
  %}
  {% form 'customer', id: form_id, class: 'knr-newsletter__form', return_to: return_url %}
    <input type='hidden' name='contact[tags]' value='newsletter'>
    {% if form.posted_successfully? %}
      <p role='status' tabindex='-1'>{{ 'knr.newsletter_success' | t }}</p>
    {% else %}
      {% if form.errors %}
        <div class='knr-error' role='alert'>{{ form.errors | default_errors }}</div>
      {% endif %}
      <div class='knr-newsletter__row'>
        <label class='knr-sr-only' for='{{ form_id }}-email'>{{ 'knr.email' | t }}</label
        ><input
          type='email'
          id='{{ form_id }}-email'
          name='contact[email]'
          value='{{ form.email | escape }}'
          required
          autocomplete='email'
          placeholder='{{ 'knr.email' | t }}'

        ><button class='knr-button' type='submit'>{{ 'knr.subscribe' | t }}</button>
      </div>
    {% endif %}
    <p class='knr-note'>{{ section.settings.note | escape }}</p>
  {% endform %}
</div>
{% stylesheet %}
  .knr-newsletter {
    padding: 120px 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .knr-newsletter__image {
    height: 540px;
    overflow: hidden;
  }
  .knr-newsletter__image img {
    width: 103.21%;
    height: 103.17%;
    max-width: none;
    transform: translate(-1.55%, -1.54%);
    object-fit: cover;
  }
  .knr-newsletter__content {
    padding: 40px;
    align-self: center;
    display: grid;
    gap: 40px;
  }
  .knr-newsletter__content h2 {
    font-size: 40px;
    line-height: 48px;
    letter-spacing: -0.04em;
  }
  .knr-newsletter__form {
    display: grid;
    gap: 16px;
  }
  .knr-newsletter__row {
    display: flex;
    box-shadow: inset 0 0 0 0.8px var(--knr-sand);
    border-radius: 2px;
    min-height: 48px;
  }
  .knr-newsletter__row input {
    width: 0;
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 12px 24px;
    outline-offset: 2px;
  }
  .knr-newsletter__row input::placeholder {
    color: var(--knr-ink);
    opacity: 1;
  }
  .knr-newsletter__row .knr-button {
    width: 160px;
    border-radius: 0 2px 2px 0;
    min-height: 48px;
  }
  @media (max-width: 1023px) and (min-width: 750px) {
    .knr-newsletter__content {
      padding: 24px;
    }
    .knr-newsletter__content h2 {
      font-size: 32px;
      line-height: 40px;
    }
    .knr-newsletter__row input::placeholder {
      color: var(--knr-ink);
      opacity: 1;
    }
    .knr-newsletter__row .knr-button {
      width: 110px;
      padding-inline: 12px;
    }
  }
  @media (max-width: 749px) {
    .knr-newsletter {
      padding: 0 24px 64px;
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .knr-newsletter__image {
      height: auto;
      position: relative;
      aspect-ratio: 342/232;
    }
    .knr-newsletter__image img {
      position: absolute;
      left: -1.6%;
      top: -1.59%;
      transform: none;
      object-fit: fill;
    }
    .knr-newsletter__content {
      padding: 0;
      gap: 40px;
    }
    .knr-newsletter__content h2 {
      font-size: 32px;
      line-height: 40px;
    }
    .knr-newsletter__row {
      display: grid;
      box-shadow: none;
      gap: 16px;
    }
    .knr-newsletter__row input {
      width: 100%;
      border: 1px solid var(--knr-sand);
      min-height: 48px;
      border-radius: 2px;
    }
    .knr-newsletter__row input::placeholder {
      color: var(--knr-ink);
      opacity: 1;
    }
    .knr-newsletter__row .knr-button {
      width: 100%;
      border-radius: 2px;
    }
  }

  .knr-newsletter__row input {
    transition:
      background-color var(--knr-hover-duration) var(--knr-hover-ease),
      border-color var(--knr-hover-duration) var(--knr-hover-ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .knr-newsletter__row input:not(:disabled):hover {
      background-color: var(--knr-paper);
      border-color: var(--knr-accent);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:knr.knr_newsletter",
  "tag": "section",
  "class": "knr-section knr-newsletter",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:knr.image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:knr.heading"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "t:knr.newsletter_note"
    }
  ]
}
{% endschema %}
