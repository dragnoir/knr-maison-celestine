{% comment %}
  KNR footer. Editable content is supplied through section settings or Shopify resources.
{% endcomment %}
<knr-footer role='contentinfo'>
  <div class='knr-footer__top'>
    {% for block in section.blocks %}
      <details class='knr-footer__menu' open {{ block.shopify_attributes }}>
        <summary>
          {{ block.settings.heading | default: block.settings.menu.title | escape -}}
          <span aria-hidden='true'>
            {%- render 'knr-icon', name: 'knr-desktop-icon1', width: 6.41421, height: 10.8284 -%}
          </span>
        </summary>
        <nav aria-label='{{ block.settings.heading | escape }}'>
          {% for link in block.settings.menu.links -%}
            <a
              class='knr-text-link'
              href='{{ link.url }}'
              {% if link.url == section.settings.cookie_preferences_link %}
                data-knr-cookie-preferences
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
          {%- endfor %}
        </nav>
      </details>
    {% endfor %}
    <div class='knr-footer__about'>
      <h2>{{ section.settings.heading | escape }}</h2>
      <div>{{ section.settings.body }}</div>
      <div class='knr-footer__certification'>
        {% if section.settings.certification_image != blank -%}
          {%- render 'knr-image',
            image: section.settings.certification_image,
            sizes: '47px',
            alt: section.settings.certification_text
          -%}
        {%- else -%}
          {%- render 'knr-icon', name: 'knr-desktop-calque1', width: 47, height: 56 -%}
        {%- endif %}
        <p>{{ section.settings.certification_text | escape }}</p>
        {% if section.settings.certification_link != blank -%}
          <a class='knr-link' href='{{ section.settings.certification_link }}'>
            {{- section.settings.certification_link_label | escape -}}
          </a>
        {%- endif %}
      </div>
    </div>
  </div>
  <div class='knr-footer__brand'>
    {% if section.settings.logo != blank -%}
      {%- render 'knr-image', image: section.settings.logo, sizes: '100vw', alt: shop.name -%}
    {%- else -%}
      <img
        src='{{ 'knr-desktop-union1.svg' | asset_url }}'
        class='knr-footer__brand-mark'
        width='1360'
        height='141'
        loading='lazy'
        alt='{{ shop.name | escape }}'
      >
    {%- endif %}
  </div>
  <div class='knr-footer__bottom'>
    <div class='knr-footer__localization'>
      {% if localization.available_countries.size > 1
        or localization.available_languages.size > 1
      -%}
        {%- assign localization_id = 'KnrLocalization-' | append: section.id %}
        {% form 'localization', id: localization_id %}
          <label class='knr-sr-only' for='{{ localization_id }}-country'>
            {{- 'knr.country' | t -}}
          </label>
          <span class='knr-footer__select'>
            <span class='knr-footer__selection' data-knr-selection aria-hidden='true' hidden></span>
            <select name='country_code' id='{{ localization_id }}-country'>
              {% for country in localization.available_countries %}
                <option
                  value='{{ country.iso_code }}'
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} ({{ country.currency.symbol }})
                </option>
              {% endfor %}
            </select>
            <span class='knr-footer__chevron' aria-hidden='true'>
              {% render 'knr-icon', name: 'knr-desktop-icon1', width: 6.41421, height: 10.8284 %}
            </span>
          </span>
          <label class='knr-sr-only' for='{{ localization_id }}-language'>
            {{- 'knr.language' | t -}}
          </label>
          <span class='knr-footer__select'>
            <span class='knr-footer__selection' data-knr-selection aria-hidden='true' hidden></span>
            <select name='language_code' id='{{ localization_id }}-language'>
              {% for language in localization.available_languages %}
                <option
                  value='{{ language.iso_code }}'
                  {% if language.iso_code == localization.language.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ language.endonym_name | capitalize }}
                </option>
              {% endfor %}
            </select>
            <span class='knr-footer__chevron' aria-hidden='true'>
              {% render 'knr-icon', name: 'knr-desktop-icon1', width: 6.41421, height: 10.8284 %}
            </span>
          </span>
          <span
            class='knr-sr-only'
            id='{{ localization_id }}-hint'
            data-knr-localization-hint
            hidden
          >
            {{- 'knr.localization_auto_apply' | t -}}
          </span>
          <button type='submit' data-knr-localization-submit>{{ 'knr.apply' | t }}</button>
        {% endform %}
      {% else -%}
        <span>{{ localization.country.name }} ({{ localization.country.currency.symbol }})</span
        ><span>{{ localization.language.endonym_name | capitalize }}</span>
      {%- endif %}
    </div>
    {% assign current_year = 'now' | date: '%Y' %}
    <p>{{ section.settings.copyright | replace: '[year]', current_year | escape }}</p>
    <div class='knr-footer__social'>
      {% assign social_networks = 'facebook,instagram,tiktok,linkedin' | split: ',' %}
      {% for network in social_networks %}
        {% if section.settings[network] != blank %}
          {% assign icon_name = 'knr-desktop-' | append: network | append: '-link' %}
          {% if network == 'linkedin' -%}
            {%- assign icon_name = 'knr-desktop-linked-in-link' -%}
          {%- endif %}
          {% if network == 'tiktok' %}{% assign icon_name = 'knr-desktop-tik-tok-link' %}{% endif %}
          {% assign social_label = 'knr.' | append: network %}
          <a
            class='knr-icon-control'
            href='{{ section.settings[network] | escape }}'
            aria-label='{{ social_label | t }}'
          >
            {% render 'knr-icon', name: icon_name, width: 20, height: 20 %}
          </a>
        {% endif %}
      {% endfor %}
      {% if section.settings.pinterest != blank %}
        <a class='knr-text-link' href='{{ section.settings.pinterest }}'>
          {{- 'knr.pinterest' | t -}}
        </a>
      {% endif %}
    </div>
  </div>
</knr-footer>
{% stylesheet %}
  .knr-footer {
    background: var(--knr-paper);
  }
  .knr-footer knr-footer {
    display: block;
  }
  .knr-footer__top {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 400px);
    gap: 40px;
    padding: 80px 40px 40px;
  }
  .knr-footer__menu {
    min-width: 0;
  }
  .knr-footer__menu summary {
    padding: 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
    pointer-events: none;
  }
  .knr-footer__menu summary::-webkit-details-marker {
    display: none;
  }
  .knr-footer__menu summary span {
    display: none;
  }
  .knr-footer__menu nav {
    display: grid;
    gap: 16px;
  }
  .knr-footer__about {
    display: grid;
    gap: 24px;
  }
  .knr-footer__certification {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .knr-footer__certification > img {
    width: 47px;
    height: 56px;
    object-fit: contain;
  }
  .knr-footer__certification p {
    box-shadow: inset 0 -1px var(--knr-sand);
    padding-bottom: 16px;
    width: 100%;
  }
  .knr-footer__certification .knr-link {
    padding-bottom: 0;
  }
  .knr-footer__brand {
    padding-inline: 40px;
  }
  .knr-footer__brand img {
    width: 100%;
    height: auto;
  }
  .knr-footer__brand .knr-footer__brand-mark {
    aspect-ratio: 1360 / 141.305;
  }
  .knr-footer__bottom {
    margin-top: 80px;
    box-shadow: inset 0 1px var(--knr-sand);
    padding: 40px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .knr-footer__localization {
    flex: 1;
    display: flex;
    gap: 16px;
  }
  .knr-footer__localization form {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .knr-footer__localization select,
  .knr-footer__localization button {
    background: transparent;
    border: 0;
    padding: 0;
    line-height: 20px;
  }
  .knr-footer__localization button {
    text-decoration: underline;
  }
  .knr-footer__select {
    display: inline-flex;
    position: relative;
  }
  .knr-footer__select select {
    appearance: none;
    border-radius: 0;
    padding-inline-end: 20px;
    cursor: pointer;
  }
  .knr-footer__selection {
    padding-inline-end: 20px;
  }
  .knr-footer__select--enhanced select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .knr-footer__select--enhanced:focus-within {
    box-shadow: inset 0 -2px var(--knr-field-focus);
  }
  @media (forced-colors: active) {
    .knr-footer__select--enhanced:focus-within {
      outline: 2px solid Highlight;
      outline-offset: 2px;
      box-shadow: none;
    }
  }
  .knr-footer__chevron {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .knr-footer__chevron img {
    transform: rotate(90deg);
  }
  .knr-footer__social {
    flex: 1;
    display: flex;
    justify-content: end;
    gap: 16px;
  }
  @media (max-width: 1023px) and (min-width: 750px) {
    .knr-footer__top {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .knr-footer__about {
      grid-column: 1/-1;
      max-width: 600px;
    }
    .knr-footer__bottom {
      flex-wrap: wrap;
    }
    .knr-footer__localization {
      flex-basis: 100%;
    }
  }
  @media (max-width: 749px) {
    .knr-footer__top {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 64px 24px 40px;
    }
    .knr-footer__menu {
      box-shadow: inset 0 1px #0035923d;
    }
    .knr-footer__menu summary {
      padding: 0;
      pointer-events: auto;
      cursor: pointer;
      margin: 0;
      padding-block: 16px;
    }
    .knr-footer__menu summary span {
      display: block;
      transform: rotate(90deg);
    }
    .knr-footer__menu[open] summary span {
      transform: rotate(-90deg);
    }
    .knr-footer__menu nav {
      padding-bottom: 24px;
    }
    .knr-footer__about {
      padding-top: 40px;
    }
    .knr-footer__certification .knr-link {
      padding-bottom: 0;
    }
    .knr-footer__brand {
      padding-inline: 0;
    }
    .knr-footer__bottom {
      margin-top: 40px;
      padding: 40px;
      display: grid;
      gap: 16px;
      justify-items: center;
      line-height: 16px;
      letter-spacing: -0.04em;
      text-align: center;
    }
    .knr-footer__localization select,
    .knr-footer__localization button {
      line-height: 16px;
    }
    .knr-footer__social {
      justify-content: center;
    }
    .knr-footer__localization {
      flex-wrap: wrap;
    }
    .knr-footer__localization form {
      justify-content: center;
    }
  }

  .knr-footer__localization :is(select, button),
  .knr-footer__select--enhanced {
    transition: background-color var(--knr-hover-duration) var(--knr-hover-ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .knr-footer__localization :is(select, button):not(:disabled):hover,
    .knr-footer__select--enhanced:hover {
      background-color: var(--knr-hover-surface);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:knr.knr_footer",
  "tag": "section",
  "class": "knr-section knr-footer",
  "settings": [
    {
      "type": "url",
      "id": "cookie_preferences_link",
      "label": "t:knr.cookie_preferences_destination"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:knr.about_heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:knr.about_description"
    },
    {
      "type": "image_picker",
      "id": "certification_image",
      "label": "t:knr.certification_image"
    },
    {
      "type": "text",
      "id": "certification_text",
      "label": "t:knr.certification_text"
    },
    {
      "type": "url",
      "id": "certification_link",
      "label": "t:knr.certification_link"
    },
    {
      "type": "text",
      "id": "certification_link_label",
      "label": "t:knr.certification_link_label"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:knr.footer_logo"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:knr.copyright"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "t:knr.instagram"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "t:knr.facebook"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "t:knr.tiktok"
    },
    {
      "type": "url",
      "id": "linkedin",
      "label": "t:knr.linkedin"
    },
    {
      "type": "url",
      "id": "pinterest",
      "label": "t:knr.pinterest"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:knr.menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:knr.menu_heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:knr.menu"
        }
      ]
    }
  ]
}
{% endschema %}
